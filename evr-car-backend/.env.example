# Banco PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/evrcar
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=troque_esta_senha

# Segurança: gere uma chave aleatória forte (mínimo 32 caracteres)
JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_FORTE_COM_MAIS_DE_32_CARACTERES
JWT_EXPIRATION_MINUTES=720

# Credenciais iniciais do administrador (configure antes de iniciar)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE

# Cloudinary: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
